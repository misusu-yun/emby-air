# ============================================================
# emby-air Docker 配置示例
# 复制为 .env 后再修改：cp .env.example .env
# 不要把真实的 .env 提交到 Git 或发到公开群。
# ============================================================

# ===================== 基础设置 =====================
# Web 管理端口（宿主机端口；容器内固定 8098）
PORT=8098

# 数据目录：数据库、图片缓存、日志都在这里，必须持久化
DATA_PATH=./data

# 宿主媒体目录：挂载到容器内 /media
# 如果有多个媒体目录，请分别挂载，或合并到同一父目录后再挂载
MEDIA_PATH=./media

# 时区
TZ=Asia/Shanghai

# 客户端显示的服务器名称
SERVER_NAME=emby-air

# 初始管理员：只在首次启动、该用户不存在时创建
# 创建后请立即在 Web 里修改密码；不要把真实密码写进公开文件
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ===================== TMDB 刮削 =====================
# TMDB API Key：留空也可以启动，之后可在 Web「设置」里填写
# 申请：https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# 刮削语言
TMDB_LANG=zh-CN

# 刮削速率：1–15 req/s；推荐 8–15
# 也可以在 Web「设置」里修改，Web 保存后优先
SCRAPE_RATE=15

# 扫描后自动刮削：1 开 / 0 关
AUTO_SCRAPE=1

# 是否写 NFO sidecar：1 开 / 0 关
# 开启时媒体目录需要可写
NFO_WRITE=0

# ===================== 代理（可选） =====================
# 只有访问 TMDB 需要代理时才填写；也可在 Web「设置」里填写
# HTTP_PROXY=http://your-proxy-host:7890
# HTTPS_PROXY=http://your-proxy-host:7890
# NO_PROXY=localhost,127.0.0.1

# ===================== 资源限制 =====================
# 低配 NAS 可按机器情况调整；Web 设置不影响这个 Docker 内存上限
MEM_LIMIT=512m
